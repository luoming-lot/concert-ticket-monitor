# ============================================
# 演唱会票务监控系统 - 环境配置示例
# 复制此文件为 .env 并修改配置
# ============================================

APP_NAME=ConcertTicketMonitor
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-here

DATABASE_URL=sqlite:///./data/concert_monitor.db

DEFAULT_MONITOR_INTERVAL=60
MIN_MONITOR_INTERVAL=10

HEADLESS=true
BROWSER_TIMEOUT=30000

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-email@qq.com

WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_DAYS=30
